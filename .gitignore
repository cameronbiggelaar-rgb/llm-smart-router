# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# Database files (auto-created on first run)
data/*.db
# SQLite runtime artifacts (created by tests/production)
data/*.db-shm
data/*.db-wal
# Captured raw compression samples for local/offline analysis
data/compression_samples/
# Routing-stats day-over-day baseline (rewritten on every nightly run)
data/routing_stats_snapshot.json
data/routing_stats_snapshot.json.tmp
# Router operational log (appended by router_ops.py on every ops run)
data/router_ops.log
# Optimiser-generated candidate proposal (regenerated with a new timestamp each run)
scripts/candidate_routing.yaml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test cache
.pytest_cache/
biggie_router.db
router_state.db
# Manual pre-recovery backups
data/*.db.bak-*
