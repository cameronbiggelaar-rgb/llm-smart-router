  "cards": [
    {
      "dot": "cyan",
      "title": "Two Planes, One Host",
      "items": [
        "Serving plane: endpoint + compression + router",
        "Evidence plane: router_logs.db → rollup → optimiser",
        "No Hermes core patching — the router is an external provider"
      ]
    },
    {
      "dot": "amber",
      "title": "Routing Inputs",
      "items": [
        "Workload type decides compression, not size alone",
        "MODEL_REGISTRY is the single source of truth",
        "Tier clamp caps normal routing below the expensive lane"
      ]
    },
    {
      "dot": "emerald",
      "title": "Prompt-Cache Identity (B34/B35)",
      "items": [
        "Derived key anchors on the FIRST USER TURN, not the system prompt",
        "Cap enforcement is gated on the key's source",
        "B35: override the generic 'custom' profile so supports_prompt_cache_key=True",
        "Live on chat-completions: real session id reaches the wire as cache_key"
      ]
    }
